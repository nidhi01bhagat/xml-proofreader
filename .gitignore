# --- Virtual environments ---
.venv/
venv/
env/

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Original assessment materials: kept local only, never committed ---
# Used locally for golden validation; committed tests use tests/fixtures/ instead.
/SSE Assignment/
# Local-only notes derived from assessment content (e.g. the unofficial gold set).
/local/

# --- Python build / cache artefacts ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Test / tooling caches ---
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Run outputs (generated by the CLI; checked-in examples live in examples/) ---
*.corrected.xml
!examples/**/*.corrected.xml
*.log
!examples/**/*.log

# --- Replay recordings (S4.4): real-document recordings stay local and are never committed;
# only invented-content fixtures under tests/fixtures/llm/ may be committed ---
*.recording.json
!tests/fixtures/llm/*.recording.json

# --- Editors / OS ---
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# --- Claude Code local settings ---
.claude/settings.local.json
