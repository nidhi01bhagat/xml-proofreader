# Copy to .env (which is git-ignored) and fill in locally. Never commit real values.
# The program reads the key from the environment only; it is never logged.

# Anthropic Console API key (pay-as-you-go). A Claude Pro/Max/Team subscription
# does NOT provide one. Not needed for offline tests or replay mode.
ANTHROPIC_API_KEY=

# Google Gemini API key, used only when the model id starts with "gemini-" (for example
# PROOFREADER_MODEL=gemini-3.5-flash-lite). Free-tier input may be read by Google and used to improve
# its products: send only invented test text on the free tier, never confidential material.
GEMINI_API_KEY=

# Optional overrides (defaults are set in proofreader.config once implemented in S4)
# PROOFREADER_MODEL=claude-opus-5-5
# PROOFREADER_CONCURRENCY=8
# PROOFREADER_TIMEOUT_SECONDS=60
